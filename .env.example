# URL of a running llama.cpp llama-server (OpenAI-compatible).
# Start with:
#   llama-server -m gemma-3-4b-it-q4_k_m.gguf -c 8192 --jinja --port 8080
LLAMA_SERVER_URL=http://localhost:8080

# Model name to send in the OpenAI request. llama-server usually ignores
# this (it serves whatever was loaded), but some clients log it.
MODEL_NAME=gemma-3-4b-it
