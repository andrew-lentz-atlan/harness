# Pick a backend in config/default.yaml (`backend:` field). The values
# here are read on demand based on which backend is active. You only
# need to fill in what you'll actually use.

# ─── litellm backend (default) ─────────────────────────────────────────
# An OpenAI-compatible hosted proxy. Atlan's LiteLLM proxy or equivalent.
# Get the URL + key from #bu-engineering-platform or whoever owns your
# proxy. Same pattern used by experiment/ and job-search/.
LITELLM_BASE_URL=https://...
LITELLM_API_KEY=sk-...

# ─── llama-server backend (local) ──────────────────────────────────────
# A local llama.cpp llama-server. No auth required.
# Start with:
#   llama-server -hf unsloth/gemma-4-E4B-it-GGUF:Q4_K_M -c 8192 --jinja --port 8080
LLAMA_SERVER_URL=http://localhost:8080

# ─── Common ────────────────────────────────────────────────────────────
# The model name sent in the request payload. For litellm, a model your
# proxy serves. For llama-server, this is mostly ignored (the server
# serves whatever was loaded with -m). The value in config/default.yaml
# overrides this when set.
MODEL_NAME=claude-haiku-4-5
